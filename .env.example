# ══════════════════════════════════════════════════════════════════════════════
# Kasi Capital — MTN MoMo Backend Configuration
# Copy this file to .env and fill in your production credentials.
# ══════════════════════════════════════════════════════════════════════════════

# ── MTN MoMo API credentials ───────────────────────────────────────────────
# Found in the MTN MoMo Developer Portal under your app's "Basic" credentials.
MTN_API_USER=
MTN_API_KEY=

# ── MTN MoMo API endpoint ──────────────────────────────────────────────────
# Production proxy for South Africa.
MTN_BASE_URL=https://proxy.momoapi.mtn.com

# ── Callback host ───────────────────────────────────────────────────────────
# Publicly reachable hostname for webhook callbacks (no trailing slash).
MTN_CALLBACK_HOST=

# ── Target environment ──────────────────────────────────────────────────────
# Must be "mtnsouthafrica" for South African production.
MTN_ENVIRONMENT=mtnsouthafrica

# ── Default currency ────────────────────────────────────────────────────────
# South African Rand.
MTN_CURRENCY=ZAR

# ── Product-specific subscription keys ──────────────────────────────────────
# Each MTN MoMo product (Collection, Disbursement, Remittance) uses its own
# subscription key.  Obtain these from the MTN MoMo Developer Portal under
# each product's "Ocp-Apim-Subscription-Key" field.

# Collection product key (used for request-to-pay, balance, refund, etc.)
KASI_COLLECTIONS_PRIMARY_KEY=

# Disbursement product key (used for transfers out, disbursement balance, etc.)
KASI_KASI_DISBURSEMENTS_PRIMARY_KEY=

# Remittance product key (used for cross-border remittance transfers)
KASI_REMITTANCES_PRIMARY_KEY=

# Legacy key — only needed if you are still using the old shared key.
# Not recommended for production.  Leave blank if using product-specific keys.
OCP_APIM_SUBSCRIPTION_KEY=

# ── User UUID ───────────────────────────────────────────────────────────────
# Internal reference UUID (optional, used for testing).
USER_1_UUID=

# ── CORS origins ────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the Netlify frontend.
CORS_ORIGINS=https://kasicapital.netlify.app,http://localhost:3000,http://localhost:5173
